# =====================================================================
# TRACE GUARD — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env (or backend/.env) and populate the values.
# NEVER commit the actual .env file or real secrets to version control.
# =====================================================================

# --- Environment Mode ---
# Options: "development", "staging", "production", "test"
ENVIRONMENT=development

# --- Database & Server Settings ---
PROJECT_NAME="TRACE GUARD"
TAGLINE="YOUR DIGITAL LIFE. YOUR CONTROL."
VERSION="1.0.0"
DATABASE_URL=sqlite:///./trace_guard.db

# --- Security & JWT Secret ---
# Generate a strong 32+ character random secret (e.g., openssl rand -hex 32)
SECRET_KEY=replace_with_secure_random_secret_at_least_32_chars
ALGORITHM=HS256

# --- Client & Server URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api

# --- Google OAuth 2.0 Credentials ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- External Threat Intelligence APIs ---
# Have I Been Pwned API Key (Optional for live enterprise breach verification)
HIBP_API_KEY=your_hibp_api_key_here
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3

# --- AI Intelligence Provider ---
# Options: "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Email & Alert Service ---
# Options: "development" (local console logging) or "resend" (production delivery)
EMAIL_PROVIDER=development
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@traceguard.local

