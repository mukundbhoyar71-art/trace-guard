# =====================================================================
# TRACE GUARD — GIT IGNORE CONFIGURATION
# =====================================================================

# --- Environment & Secret Files ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow safe example templates
!.env.example
!backend/.env.example

# --- Python & Virtual Environments ---
.venv/
venv/
env/
ENV/
backend/venv/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# --- Node & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Databases & Backups ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backups/
backend/backups/

# --- Generated Reports & User Data ---
storage/
backend/storage/
backend/storage/reports/
*.pdf

# --- Logs & Temporary Files ---
*.log
*.tmp
tmp/
temp/

# --- IDEs & OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
